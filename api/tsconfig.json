{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "outDir": "dist",
        "rootDir": "_src",
        "skipLibCheck": true,
        "types": [
            "@cloudflare/workers-types"
        ]
    },
    "include": [
        "_src/**/*"
    ],
    "exclude": [
        "_src/index.ts"
    ]
}