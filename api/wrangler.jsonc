{
    // DesignDNA — Cloudflare Workers deployment
    // API (Hono) + Frontend (React SPA) as single Worker
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "design-dna",
    "main": "_src/worker.ts",
    "compatibility_date": "2025-04-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    // Smart Placement — run Worker in US (Gemini API geo-restricts Asian IPs)
    "placement": {
        "mode": "smart",
        "hint": "enam"
    },
    // Static Assets — serve React SPA from app/dist
    "assets": {
        "directory": "../app/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "html_handling": "auto-trailing-slash",
        "run_worker_first": [
            "/api/*"
        ]
    },
    // Observability
    "observability": {
        "enabled": true
    }
}